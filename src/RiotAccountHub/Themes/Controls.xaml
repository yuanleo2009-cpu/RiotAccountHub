<!--
  共用控制項樣式：文字、按鈕、卡片、標籤。全部引用 Tokens.xaml 的設計代碼。
  按鈕和卡片都有滑過、按下的動畫（150–250 毫秒）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:helpers="clr-namespace:RiotAccountHub.Helpers">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <!-- ===================== 視窗 ===================== -->
    <!-- FluentWindow：WPF UI 的視窗，支援 Mica 背景與自訂標題列 -->
    <Style x:Key="Window.App" TargetType="{x:Type ui:FluentWindow}" BasedOn="{StaticResource {x:Type ui:FluentWindow}}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="ExtendsContentIntoTitleBar" Value="True" />
        <Setter Property="WindowBackdropType" Value="Mica" />
        <Setter Property="WindowCornerPreference" Value="Round" />
    </Style>

    <!-- ===================== 文字 ===================== -->
    <Style x:Key="Text.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- Riot ID：整個畫面最醒目的字 -->
    <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Display}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Title}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style x:Key="Text.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}" />
    <Style x:Key="Text.BodySecondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource Font.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>
    <Style x:Key="Text.CaptionSecondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>

    <!-- 鍵盤焦點外框 -->
    <Style x:Key="Focus.Ring">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="6" RadiusY="6" StrokeThickness="2"
                               Stroke="{StaticResource Brush.Accent}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 按鈕 ===================== -->
    <!--
      所有按鈕共用的外型與動畫（用 WPF UI 的 ui:Button，才有 Icon 屬性）：
        - 滑過：一層半透明白淡入（150 毫秒）
        - 按下：整顆按鈕縮小到 97%，放開再彈回來
    -->
    <ControlTemplate x:Key="Btn.Template" TargetType="{x:Type ui:Button}">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="HoverLayer" Opacity="0"
                    Background="{TemplateBinding MouseOverBackground}"
                    BorderBrush="{TemplateBinding MouseOverBorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="PressLayer" Opacity="0"
                    Background="{TemplateBinding PressedBackground}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        TextElement.Foreground="{TemplateBinding Foreground}">
                <ContentPresenter x:Name="IconHost" Content="{TemplateBinding Icon}" Margin="{StaticResource Gap.Right8}"
                                  VerticalAlignment="Center" TextElement.FontSize="{StaticResource Size.Icon}" />
                <ContentPresenter x:Name="ContentHost" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter TargetName="IconHost" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="{StaticResource Motion.Fast}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{StaticResource Motion.Normal}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.08" />
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="0.97" Duration="0:0:0.08" />
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="0.97" Duration="0:0:0.08" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="PressLayer" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{StaticResource Motion.Normal}" />
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="{StaticResource Motion.Normal}">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="{StaticResource Motion.Normal}">
                                <DoubleAnimation.EasingFunction>
                                    <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Btn.Base" TargetType="{x:Type ui:Button}">
        <Setter Property="Template" Value="{StaticResource Btn.Template}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Ui}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Body}" />
        <Setter Property="Height" Value="{StaticResource Size.Button}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Button}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
        <Setter Property="MouseOverBackground" Value="{StaticResource Brush.HoverOverlay}" />
        <Setter Property="MouseOverBorderBrush" Value="Transparent" />
        <Setter Property="PressedBackground" Value="{StaticResource Brush.PressOverlay}" />
    </Style>

    <!-- 主要按鈕：紅色。一個畫面最重要的動作才用 -->
    <Style x:Key="Btn.Primary" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextOnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MouseOverBackground" Value="{StaticResource Brush.AccentHover}" />
        <Setter Property="PressedBackground" Value="{StaticResource Brush.AccentPressed}" />
    </Style>

    <!-- 「啟動」：卡片上最顯眼的按鈕 -->
    <Style x:Key="Btn.Launch" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Height" Value="{StaticResource Size.ButtonLarge}" />
        <Setter Property="MinWidth" Value="168" />
        <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- 次要按鈕：深灰底、細邊框 -->
    <Style x:Key="Btn.Secondary" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="MouseOverBorderBrush" Value="{StaticResource Brush.StrokeStrong}" />
    </Style>
    <Style x:Key="Btn.SecondaryLarge" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource Btn.Secondary}">
        <Setter Property="Height" Value="{StaticResource Size.ButtonLarge}" />
    </Style>

    <!-- 透明按鈕：平常只有文字，滑過才有底色 -->
    <Style x:Key="Btn.Ghost" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Btn.GhostSmall" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Height" Value="{StaticResource Size.ButtonSmall}" />
        <Setter Property="Padding" Value="{StaticResource Pad.ButtonSmall}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Caption}" />
    </Style>

    <!-- 只有圖示的小按鈕（滑鼠移上去會顯示說明） -->
    <Style x:Key="Btn.Icon" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Height" Value="{StaticResource Size.ButtonSmall}" />
        <Setter Property="Width" Value="{StaticResource Size.ButtonSmall}" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <!-- 危險動作（刪除）：滑過時變紅 -->
    <Style x:Key="Btn.IconDanger" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource Btn.Icon}">
        <Setter Property="MouseOverBackground" Value="{StaticResource Brush.AccentSoft}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== 標籤 ===================== -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource Size.Tag}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Tag}" />
        <Setter Property="Margin" Value="{StaticResource Gap.TagRow}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Tag}" />
        <Setter Property="Background" Value="{StaticResource Brush.Surface3}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- 重點資訊（例如「主帳號」）才用紅色標籤 -->
    <Style x:Key="Chip.Accent" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
    </Style>
    <Style x:Key="Chip.Warning" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{StaticResource Brush.WarningSoft}" />
    </Style>
    <Style x:Key="Chip.Text" TargetType="TextBlock" BasedOn="{StaticResource Text.CaptionSecondary}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== 卡片 ===================== -->
    <!--
      互動卡片（帳號卡片用）：
        - 平常：深色底、細邊框、左側一條灰線
        - 滑過：往上浮 2px、出現陰影、邊框和左側的線變成紅色（200 毫秒）
        - 使用中（helpers:CardState.IsActive="True"）：左側的線一直是紅色
      用法：<ContentControl Style="{StaticResource Card.Interactive}"> 內容 </ContentControl>
    -->
    <Style x:Key="Card.Interactive" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid x:Name="Root">
                        <Grid.RenderTransform>
                            <TranslateTransform Y="0" />
                        </Grid.RenderTransform>

                        <!-- 陰影（平常看不到，滑過才淡入） -->
                        <Border x:Name="Shadow" Opacity="0" Background="{StaticResource Brush.Surface1}"
                                CornerRadius="{StaticResource Radius.Card}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Color="Black" Opacity="0.6" />
                            </Border.Effect>
                        </Border>

                        <!-- 圓角遮罩：讓裡面的圖片和紅線都被裁成圓角 -->
                        <Border x:Name="Mask" Background="{StaticResource Brush.Surface1}"
                                CornerRadius="{StaticResource Radius.Card}" />
                        <Grid>
                            <Grid.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=Mask}" />
                            </Grid.OpacityMask>
                            <ContentPresenter />
                            <!-- 左側的線：平常灰色，滑過變紅 -->
                            <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource Brush.StrokeStrong}" />
                            <Rectangle x:Name="AccentBar" Width="3" HorizontalAlignment="Left" Opacity="0"
                                       Fill="{StaticResource Brush.Accent}" />
                            <!-- 使用中的帳號（helpers:CardState.IsActive）：紅線一直亮著 -->
                            <Rectangle x:Name="ActiveBar" Width="3" HorizontalAlignment="Left" Visibility="Collapsed"
                                       Fill="{StaticResource Brush.Accent}" />
                        </Grid>

                        <!-- 邊框：平常細灰線，滑過疊上紅線 -->
                        <Border BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1" IsHitTestVisible="False"
                                CornerRadius="{StaticResource Radius.Card}" />
                        <Border x:Name="HoverStroke" BorderBrush="{StaticResource Brush.AccentStroke}" BorderThickness="1"
                                Opacity="0" IsHitTestVisible="False" CornerRadius="{StaticResource Radius.Card}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="helpers:CardState.IsActive" Value="True">
                            <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="-2" Duration="{StaticResource Motion.Normal}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource Motion.Normal}" />
                                        <DoubleAnimation Storyboard.TargetName="HoverStroke" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource Motion.Normal}" />
                                        <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource Motion.Normal}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                         To="0" Duration="{StaticResource Motion.Slow}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Motion.Slow}" />
                                        <DoubleAnimation Storyboard.TargetName="HoverStroke" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Motion.Slow}" />
                                        <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource Motion.Slow}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 一般面板（進度畫面、提示框） -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Surface1}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Dialog}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 成功提示框 -->
    <Style x:Key="Notice.Success" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.SuccessSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.SuccessStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Notice}" />
    </Style>

</ResourceDictionary>
