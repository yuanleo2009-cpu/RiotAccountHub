<!--
  設計代碼（Design Tokens）：整個程式唯一的一套顏色、字號、圓角、間距。
  風格：「夜戰紅線」——接近純黑的冷色底、細邊框、稜角俐落，強調色只有一個紅色。

  規則：
    - 畫面檔（Views）不直接寫顏色和字號，一律引用這裡的資源
    - 強調色（紅）只用在：主要按鈕、選中狀態、重點資訊
    - 間距用 8 的倍數（4 只用在標籤內部這種很小的地方）
    - 想調整整體風格，改這個檔案就好
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===================== 顏色 ===================== -->
    <!-- 底色與表面（由深到淺） -->
    <Color x:Key="Color.Bg">#0C0F14</Color>
    <Color x:Key="Color.BgTint">#C70C0F14</Color>      <!-- 蓋在 Mica 上面的色罩，讓底色維持冷黑 -->
    <Color x:Key="Color.Surface1">#141820</Color>      <!-- 卡片 -->
    <Color x:Key="Color.Surface2">#1A202B</Color>      <!-- 按鈕、輸入框 -->
    <Color x:Key="Color.Surface3">#232A37</Color>      <!-- 標籤、滑過時 -->
    <Color x:Key="Color.Stroke">#232936</Color>        <!-- 細邊框 -->
    <Color x:Key="Color.StrokeStrong">#36404F</Color>
    <Color x:Key="Color.Overlay">#D9080A0E</Color>     <!-- 進度畫面後面的遮罩 -->

    <!-- 文字 -->
    <Color x:Key="Color.Text">#F3F5F8</Color>
    <Color x:Key="Color.TextSecondary">#AAB2C0</Color>
    <Color x:Key="Color.TextMuted">#6B7483</Color>

    <!-- 強調色：唯一的紅色 -->
    <Color x:Key="Color.Accent">#FF4655</Color>
    <Color x:Key="Color.AccentHover">#FF6470</Color>
    <Color x:Key="Color.AccentPressed">#DB3847</Color>
    <Color x:Key="Color.AccentSoft">#29FF4655</Color>
    <Color x:Key="Color.AccentStroke">#80FF4655</Color>

    <!-- 狀態色：只用在「成功 / 警告」這類狀態訊息 -->
    <Color x:Key="Color.Success">#3DD68C</Color>
    <Color x:Key="Color.SuccessSoft">#1F3DD68C</Color>
    <Color x:Key="Color.SuccessStroke">#663DD68C</Color>
    <Color x:Key="Color.Warning">#F0B429</Color>
    <Color x:Key="Color.WarningSoft">#1FF0B429</Color>

    <!-- 筆刷 -->
    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.BgTint" Color="{StaticResource Color.BgTint}" />
    <SolidColorBrush x:Key="Brush.Surface1" Color="{StaticResource Color.Surface1}" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}" />
    <SolidColorBrush x:Key="Brush.Stroke" Color="{StaticResource Color.Stroke}" />
    <SolidColorBrush x:Key="Brush.StrokeStrong" Color="{StaticResource Color.StrokeStrong}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextOnAccent" Color="White" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentStroke" Color="{StaticResource Color.AccentStroke}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.SuccessStroke" Color="{StaticResource Color.SuccessStroke}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />

    <!-- 滑過 / 按下時蓋上去的半透明白（用淡入淡出做動畫） -->
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Brush.PressOverlay" Color="#0AFFFFFF" />

    <!-- 視窗右上角淡淡的紅色光暈 -->
    <RadialGradientBrush x:Key="Brush.AccentGlow" Center="0.88,0" GradientOrigin="0.88,0" RadiusX="0.55" RadiusY="0.5">
        <GradientStop Color="#22FF4655" Offset="0" />
        <GradientStop Color="#00FF4655" Offset="1" />
    </RadialGradientBrush>

    <!-- 帳號卡片上，蓋在卡面圖片上的漸層（左邊實、右邊透，名字才看得清楚） -->
    <LinearGradientBrush x:Key="Brush.CardBannerFade" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF141820" Offset="0" />
        <GradientStop Color="#E6141820" Offset="0.35" />
        <GradientStop Color="#8C141820" Offset="1" />
    </LinearGradientBrush>

    <!-- 沒有卡面圖片時的頭像底色（中性灰，不用強調色） -->
    <LinearGradientBrush x:Key="Brush.AvatarFallback" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2B3342" Offset="0" />
        <GradientStop Color="#1A202B" Offset="1" />
    </LinearGradientBrush>

    <!-- 讓 WPF UI 自己的控制項也用同一個底色（不支援 Mica 時就是這個純深色） -->
    <Color x:Key="ApplicationBackgroundColor">#0C0F14</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#0C0F14" />
    <!-- WPF UI 的開關：打開時（紅底）圓點用白色 -->
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="White" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="White" />

    <!-- ===================== 字體與字號 ===================== -->
    <!-- 英文用 Segoe UI，中文用 Microsoft JhengHei UI（微軟正黑體） -->
    <FontFamily x:Key="FontFamily.Ui">Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI</FontFamily>
    <FontFamily x:Key="FontFamily.Display">Segoe UI Variable Display, Segoe UI, Microsoft JhengHei UI</FontFamily>

    <sys:Double x:Key="Font.Caption">12</sys:Double>   <!-- 小字、標籤 -->
    <sys:Double x:Key="Font.Body">14</sys:Double>      <!-- 內文、按鈕 -->
    <sys:Double x:Key="Font.Subtitle">16</sys:Double>  <!-- 小標題 -->
    <sys:Double x:Key="Font.Title">20</sys:Double>     <!-- 頁面標題 -->
    <sys:Double x:Key="Font.Display">24</sys:Double>   <!-- Riot ID -->

    <!-- ===================== 圓角 ===================== -->
    <CornerRadius x:Key="Radius.Tag">3</CornerRadius>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">10</CornerRadius>

    <!-- ===================== 尺寸 ===================== -->
    <sys:Double x:Key="Size.Button">36</sys:Double>
    <sys:Double x:Key="Size.ButtonSmall">28</sys:Double>
    <sys:Double x:Key="Size.ButtonLarge">44</sys:Double>
    <sys:Double x:Key="Size.Tag">24</sys:Double>
    <sys:Double x:Key="Size.Avatar">56</sys:Double>
    <sys:Double x:Key="Size.Icon">16</sys:Double>
    <sys:Double x:Key="Size.IconSmall">14</sys:Double>
    <sys:Double x:Key="Size.DialogIcon">40</sys:Double>   <!-- 對話框標題旁的圖示方塊 -->
    <sys:Double x:Key="Size.StepDot">24</sys:Double>      <!-- 登入步驟的數字圓點 -->
    <sys:Double x:Key="Size.ButtonMinWidth">96</sys:Double>
    <sys:Double x:Key="Size.SearchBox">280</sys:Double>
    <sys:Double x:Key="Size.TileMinWidth">232</sys:Double>     <!-- 準星卡片最少多寬 -->
    <sys:Double x:Key="Size.TilePreview">184</sys:Double>      <!-- 準星卡片上的預覽高度 -->
    <sys:Double x:Key="Size.DetailPreview">320</sys:Double>    <!-- 準星大圖預覽高度 -->
    <sys:Double x:Key="Size.EditorPreview">168</sys:Double>    <!-- 新增準星時的預覽高度 -->
    <sys:Double x:Key="Spacing.Tile">16</sys:Double>

    <!-- ===================== 間距（8 的倍數） ===================== -->
    <Thickness x:Key="Pad.Page">24,8,24,16</Thickness>        <!-- 頁面標題區 -->
    <Thickness x:Key="Pad.PageSides">24,0</Thickness>
    <Thickness x:Key="Pad.List">24,8,16,8</Thickness>         <!-- 卡片列表（右邊留給捲軸） -->
    <Thickness x:Key="Pad.Card">24,16,16,16</Thickness>       <!-- 卡片內容（左邊多 8 讓出紅線） -->
    <Thickness x:Key="Pad.Panel">32,24</Thickness>            <!-- 進度面板 -->
    <Thickness x:Key="Pad.Bar">24,8</Thickness>               <!-- 底部狀態列 -->
    <Thickness x:Key="Pad.Notice">16,8</Thickness>
    <Thickness x:Key="Gap.Banner">24,0,24,16</Thickness>      <!-- 「已複製」橫幅的外距 -->
    <Thickness x:Key="Pad.Button">16,0</Thickness>
    <Thickness x:Key="Pad.ButtonSmall">8,0</Thickness>
    <Thickness x:Key="Pad.Tag">8,0</Thickness>
    <Thickness x:Key="Pad.Dialog">24,0,24,24</Thickness>      <!-- 對話框內容（上面已經有標題列的空間） -->
    <Thickness x:Key="Pad.DialogFooter">24,16</Thickness>     <!-- 對話框底部按鈕列 -->
    <Thickness x:Key="Pad.Input">8,0</Thickness>              <!-- 輸入框裡的文字 -->
    <Thickness x:Key="Pad.Steps">16</Thickness>               <!-- 登入步驟的框 -->
    <Thickness x:Key="Pad.Choice">16,0</Thickness>            <!-- 登入方式的選項 -->
    <Thickness x:Key="Pad.TileFooter">16,8,8,8</Thickness>     <!-- 準星卡片下方的名稱列 -->
    <Thickness x:Key="Pad.InputSearch">32,0,8,0</Thickness>   <!-- 搜尋框（左邊讓出放大鏡） -->
    <Thickness x:Key="Pad.InputMulti">8</Thickness>           <!-- 多行輸入框 -->
    <Thickness x:Key="Pad.Toolbar">16,8</Thickness>           <!-- 瀏覽器工具列 -->

    <Thickness x:Key="Gap.Right4">0,0,4,0</Thickness>
    <Thickness x:Key="Gap.Right8">0,0,8,0</Thickness>
    <Thickness x:Key="Gap.Right16">0,0,16,0</Thickness>
    <Thickness x:Key="Gap.Left8">8,0,0,0</Thickness>
    <Thickness x:Key="Gap.Left16">16,0,0,0</Thickness>
    <Thickness x:Key="Gap.Top4">0,4,0,0</Thickness>
    <Thickness x:Key="Gap.Top8">0,8,0,0</Thickness>
    <Thickness x:Key="Gap.Top16">0,16,0,0</Thickness>
    <Thickness x:Key="Gap.Top24">0,24,0,0</Thickness>
    <Thickness x:Key="Gap.Top32">0,32,0,0</Thickness>
    <Thickness x:Key="Gap.Bottom8">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Bottom16">0,0,0,16</Thickness>
    <Thickness x:Key="Gap.TagRow">0,0,8,0</Thickness>         <!-- 標籤之間 -->

    <!-- ===================== 動畫時間（150–250 毫秒） ===================== -->
    <Duration x:Key="Motion.Fast">0:0:0.15</Duration>
    <Duration x:Key="Motion.Normal">0:0:0.2</Duration>
    <Duration x:Key="Motion.Slow">0:0:0.25</Duration>

</ResourceDictionary>
