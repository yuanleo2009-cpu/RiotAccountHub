<Window x:Class="RiotAccountHub.Views.CrosshairsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RiotAccountHub.ViewModels"
        xmlns:helpers="clr-namespace:RiotAccountHub.Helpers"
        Style="{StaticResource DarkWindowStyle}"
        Title="熱門準星"
        Width="920" Height="700" MinWidth="640" MinHeight="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!--
      「熱門準星」視窗。DataContext 是 CrosshairsViewModel。
      卡片網格：預覽圖、名稱、收藏、複製；點卡片看大圖。
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
                    VerticalAlignment="Center" ToolTip="貼上準星代碼、取個名字，存進「我的準星」">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource ButtonIcon}" />
                    <TextBlock Text="新增我的準星" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="熱門準星" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Text="收藏準星代碼、預覽樣子、一鍵複製。想找大家都在用的熱門準星，可以按下方「在 VCRDB 看更多」。" />
            </StackPanel>
        </DockPanel>

        <!-- 搜尋、篩選、背景 -->
        <DockPanel Grid.Row="1" Margin="0,18,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="預覽背景" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,8" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="Bg" Content="牆面" IsChecked="{Binding IsMapBackground}" ToolTip="模擬遊戲裡的水泥牆" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="Bg" Content="深色" IsChecked="{Binding IsDarkBackground}" />
                <RadioButton Style="{StaticResource ChipRadio}" GroupName="Bg" Content="淺色" IsChecked="{Binding IsLightBackground}" Margin="0,0,0,8" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="240" Margin="0,0,16,8">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="28,7,8,7" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" IsHitTestVisible="False"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Text="用名字搜尋" IsHitTestVisible="False" Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="32,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <CheckBox Style="{StaticResource ToggleSwitch}" Content="只看收藏" IsChecked="{Binding ShowFavoritesOnly}"
                          VerticalAlignment="Center" Margin="0,0,0,8" />
            </StackPanel>
        </DockPanel>

        <!-- 準星卡片網格 -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ItemsView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CrosshairItemViewModel}">
                            <Border x:Name="CardBorder" Style="{StaticResource Card}" Width="196" Padding="0" Margin="0,0,12,12"
                                    Cursor="Hand" ToolTip="點一下看大圖">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <StackPanel>
                                    <!-- 預覽圖（程式自己畫的，不使用網站圖片） -->
                                    <Border CornerRadius="11,11,0,0" ClipToBounds="True" Height="160">
                                        <helpers:CrosshairPreview Code="{Binding Code}" PixelScale="2"
                                                                  BackgroundMode="{Binding DataContext.BackgroundMode, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Border>
                                    <DockPanel Margin="14,10,10,12">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}" Padding="6,4" ToolTip="收藏"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xE734;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE735;" />
                                                                    <Setter Property="Foreground" Value="#FFD978" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Padding="6,4" ToolTip="複製代碼"
                                                    Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SourceText}" FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="沒有符合的準星" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="換個名字搜尋，或關掉「只看收藏」。" Margin="0,8,0,0" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- 提示（例如「已複製！…」） -->
        <Border Grid.Row="3" Margin="0,6,0,0" CornerRadius="8" Padding="14,9" Background="#263FB950"
                BorderBrush="#663FB950" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NoticeText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           Foreground="{StaticResource SuccessBrush}" Margin="0,1,10,0" />
                <TextBlock Text="{Binding NoticeText}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <!-- 底部：在 VCRDB 看更多 -->
        <Border Grid.Row="4" Margin="0,12,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding OpenVcrdbCommand}"
                        ToolTip="在程式裡打開 VCRDB 網站，直接在網站上挑選、複製準星">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" Style="{StaticResource ButtonIcon}" />
                        <TextBlock Text="在 VCRDB 看更多" />
                    </StackPanel>
                </Button>
                <TextBlock FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="VCRDB（Valorant Crosshair Database）的使用條款不允許轉載網站內容，所以這裡沒有內建它的排行榜；請直接在網站上挑，複製後回來按「新增我的準星」。" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
