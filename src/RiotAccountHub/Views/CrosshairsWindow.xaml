<ui:FluentWindow x:Class="RiotAccountHub.Views.CrosshairsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:RiotAccountHub.ViewModels"
                 xmlns:helpers="clr-namespace:RiotAccountHub.Helpers"
                 Style="{StaticResource Window.App}"
                 Title="我的準星"
                 Width="1000" Height="720" MinWidth="720" MinHeight="520"
                 ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!--
      「我的準星」視窗。DataContext 是 CrosshairsViewModel。
      結構：標題列 → 標題與按鈕 → 搜尋 / 篩選 / 預覽背景 → 準星卡片網格 → 底部 VCRDB 說明。
      複製成功時，從底部滑出提示（Snackbar）。
    -->
    <Grid>
        <Border Background="{StaticResource Brush.BgTint}" />
        <Border Background="{StaticResource Brush.AccentGlow}" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" Title="我的準星">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/RiotAccountHub;component/Assets/logo.png" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <!-- 標題 -->
            <DockPanel Grid.Row="1" Margin="{StaticResource Pad.Page}">
                <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" VerticalAlignment="Center"
                           Icon="{ui:SymbolIcon Add20}" Content="新增我的準星"
                           Command="{Binding AddCommand}"
                           ToolTip="貼上準星代碼、取個名字，存進「我的準星」" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="我的準星" Style="{StaticResource Text.Display}" />
                    <TextBlock Style="{StaticResource Text.CaptionSecondary}" Margin="{StaticResource Gap.Top4}"
                               Text="收藏準星代碼、預覽樣子、一鍵複製。點卡片可以看大圖。" />
                </StackPanel>
            </DockPanel>

            <!-- 搜尋、只看收藏、預覽背景 -->
            <DockPanel Grid.Row="2" Margin="24,0,24,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="預覽背景" Style="{StaticResource Text.CaptionSecondary}" VerticalAlignment="Center" />
                    <RadioButton Style="{StaticResource Choice.Small}" GroupName="Bg" Content="牆面" IsChecked="{Binding IsMapBackground}" ToolTip="模擬遊戲裡的水泥牆" />
                    <RadioButton Style="{StaticResource Choice.Small}" GroupName="Bg" Content="深色" IsChecked="{Binding IsDarkBackground}" />
                    <RadioButton Style="{StaticResource Choice.Small}" GroupName="Bg" Content="淺色" IsChecked="{Binding IsLightBackground}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 搜尋框：左邊放大鏡，沒有字時顯示提示文字 -->
                    <Grid Width="{StaticResource Size.SearchBox}" Margin="{StaticResource Gap.Right16}">
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Padding="{StaticResource Pad.InputSearch}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:SymbolIcon Symbol="Search20" FontSize="{StaticResource Size.Icon}" IsHitTestVisible="False"
                                       Foreground="{StaticResource Brush.TextMuted}" HorizontalAlignment="Left"
                                       VerticalAlignment="Center" Margin="{StaticResource Gap.Left8}" />
                        <TextBlock Text="用名字搜尋" IsHitTestVisible="False" Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="33,0,0,0">
                            <TextBlock.Visibility>
                                <Binding Path="Text.IsEmpty" ElementName="SearchBox" Converter="{StaticResource BoolToVis}" />
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                    <TextBlock Text="只看收藏" Style="{StaticResource Text.CaptionSecondary}" VerticalAlignment="Center"
                               Margin="{StaticResource Gap.Right8}" />
                    <ui:ToggleSwitch IsChecked="{Binding ShowFavoritesOnly}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- 準星卡片網格 -->
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{StaticResource Pad.List}">
                    <ItemsControl ItemsSource="{Binding ItemsView}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:TileGrid MinItemWidth="{StaticResource Size.TileMinWidth}" Spacing="{StaticResource Spacing.Tile}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CrosshairItemViewModel}">
                                <ContentControl Style="{StaticResource Card.Tile}" helpers:Motion.Enter="True" ToolTip="點一下看大圖">
                                    <ContentControl.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}" />
                                    </ContentControl.InputBindings>
                                    <StackPanel>
                                        <!-- 預覽圖（程式自己畫的，不使用網站圖片） -->
                                        <helpers:CrosshairPreview Code="{Binding Code}" PixelScale="3" Height="{StaticResource Size.TilePreview}"
                                                                  BackgroundMode="{Binding DataContext.BackgroundMode, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Border Height="1" Background="{StaticResource Brush.Stroke}" />
                                        <DockPanel Margin="{StaticResource Pad.TileFooter}" Background="{StaticResource Brush.Surface1}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- 收藏：收藏後是紅色實心星星 -->
                                                <ui:Button Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}">
                                                    <ui:Button.Style>
                                                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource Btn.Icon}">
                                                            <Setter Property="ToolTip" Value="收藏" />
                                                            <Setter Property="Icon" Value="{ui:SymbolIcon Star20}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="ToolTip" Value="取消收藏" />
                                                                    <Setter Property="Icon" Value="{ui:SymbolIcon Star20, Filled=True}" />
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ui:Button.Style>
                                                </ui:Button>
                                                <ui:Button Style="{StaticResource Btn.GhostSmall}" Icon="{ui:SymbolIcon Copy20}" Content="複製"
                                                           ToolTip="複製準星代碼"
                                                           Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource Text.CaptionSecondary}"
                                                           Foreground="{StaticResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 沒有符合的準星 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            helpers:Motion.IsShown="{Binding IsEmpty}">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource Brush.Surface2}" HorizontalAlignment="Center">
                        <ui:SymbolIcon Symbol="SearchInfo24" FontSize="28" Foreground="{StaticResource Brush.TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="沒有符合的準星" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center"
                               Margin="{StaticResource Gap.Top16}" />
                    <TextBlock Text="換個名字搜尋，或關掉「只看收藏」。" Style="{StaticResource Text.BodySecondary}"
                               HorizontalAlignment="Center" Margin="{StaticResource Gap.Top8}" />
                </StackPanel>
            </Grid>

            <!-- 底部：在 VCRDB 看更多 -->
            <Border Grid.Row="4" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="0,1,0,0" Padding="{StaticResource Pad.Bar}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" VerticalAlignment="Center"
                               Icon="{ui:SymbolIcon Globe20}" Content="在 VCRDB 看更多"
                               Command="{Binding OpenVcrdbCommand}"
                               helpers:Motion.IsShown="{Binding ShowVcrdbButton}"
                               ToolTip="在程式裡打開 VCRDB 網站，直接在網站上挑選、複製準星" />
                    <ui:SymbolIcon Symbol="Info16" FontSize="{StaticResource Size.IconSmall}" Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center" Margin="{StaticResource Gap.Right8}" />
                    <TextBlock Style="{StaticResource Text.CaptionSecondary}" Foreground="{StaticResource Brush.TextMuted}"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="{StaticResource Gap.Right16}"
                               Text="VCRDB 的使用條款不允許轉載網站內容，所以這裡沒有內建它的排行榜。請到網站上挑選，複製後回來按「新增我的準星」。" />
                </DockPanel>
            </Border>

            <!-- 從底部滑出的提示（例如「已複製準星代碼」） -->
            <ui:SnackbarPresenter x:Name="Snackbars" Grid.Row="0" Grid.RowSpan="5" VerticalAlignment="Bottom"
                                  Margin="24,0,24,72" />
        </Grid>
    </Grid>
</ui:FluentWindow>
