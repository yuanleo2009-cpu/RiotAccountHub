<Window x:Class="RiotAccountHub.Views.SettingsSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RiotAccountHub.ViewModels"
        Style="{StaticResource DarkWindowStyle}"
        Title="同步遊戲設定"
        Width="620" Height="660" MinHeight="520"
        ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <!--
      「同步遊戲設定」視窗。DataContext 是 SettingsSyncViewModel。
      流程：匯出目前帳號的設定 → 切換到另一個帳號 → 套用（會先自動備份）→ 不喜歡就還原
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid Margin="28,24,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 標題 -->
            <StackPanel>
                <TextBlock Text="同步遊戲設定" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="把一個帳號的鍵位、靈敏度、準星等設定，一鍵套用到另一個帳號。" />
            </StackPanel>

            <!-- 目前登入的帳號 -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="18,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" VerticalAlignment="Top"
                            Command="{Binding RefreshCommand}" ToolTip="重新讀取目前登入的帳號">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource ButtonIcon}" FontSize="12" Margin="0,1,6,0" />
                            <TextBlock Text="重新整理" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="目前登入的帳號" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding CurrentAccountText}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentAccountHint}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 已存的設定檔標題 + 匯出按鈕 -->
            <DockPanel Grid.Row="2" Margin="0,22,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource ButtonIcon}" />
                        <TextBlock Text="匯出目前帳號的設定" />
                    </StackPanel>
                </Button>
                <TextBlock Text="已儲存的設定檔" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- 設定檔清單 -->
            <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,0,4,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SettingsProfileItem}">
                                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource DangerGhostButton}" FontSize="13" Padding="8,5" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" ToolTip="刪除這個設定檔（不影響任何帳號）">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                            </Button>
                                            <Button Style="{StaticResource PrimaryButton}" MinWidth="88"
                                                    Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE8FB;" Style="{StaticResource ButtonIcon}" />
                                                    <TextBlock Text="套用" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,4,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 沒有設定檔時的說明 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="還沒有任何設定檔" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,0" TextAlignment="Center" LineHeight="22" Foreground="{StaticResource TextSecondaryBrush}">
                        1. 用設定好的帳號登入，按「匯出目前帳號的設定」<LineBreak />
                        2. 回主畫面切換到另一個帳號<LineBreak />
                        3. 再打開這個視窗，對設定檔按「套用」
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- 還原 -->
            <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,10,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding RestoreCommand}" IsEnabled="{Binding HasBackup}"
                            ToolTip="把目前帳號的設定改回最近一次套用前的樣子">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource ButtonIcon}" />
                            <TextBlock Text="還原套用前的設定" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding BackupText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                               Margin="0,0,12,0" Foreground="{StaticResource TextMutedBrush}" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- 忙碌中 -->
        <Grid Background="{StaticResource OverlayBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" MaxWidth="440">
                <StackPanel>
                    <Path Width="36" Height="36" HorizontalAlignment="Center" Stroke="{StaticResource AccentBrush}" StrokeThickness="4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 18,2 A 16,16 0 1 1 2,18" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform />
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                    <TextBlock Text="{Binding BusyText}" Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
