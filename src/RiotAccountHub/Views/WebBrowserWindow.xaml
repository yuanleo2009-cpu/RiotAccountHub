<ui:FluentWindow x:Class="RiotAccountHub.Views.WebBrowserWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
                 Style="{StaticResource Window.App}"
                 Width="1180" Height="800" MinWidth="720" MinHeight="500"
                 ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- 程式內的簡單瀏覽器（WebView2），用來開 VCRDB 讓使用者自己挑選、複製準星 -->
    <Grid>
        <Border Background="{StaticResource Brush.BgTint}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/RiotAccountHub;component/Assets/logo.png" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <!-- 工具列：上一頁 / 下一頁 / 重新整理、說明、我的準星、用瀏覽器開啟、完成 -->
            <Border Grid.Row="1" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="0,0,0,1" Padding="{StaticResource Pad.Toolbar}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource Gap.Right16}">
                        <ui:Button Style="{StaticResource Btn.Icon}" Icon="{ui:SymbolIcon ArrowLeft20}" ToolTip="上一頁" Click="OnBack" />
                        <ui:Button Style="{StaticResource Btn.Icon}" Icon="{ui:SymbolIcon ArrowRight20}" ToolTip="下一頁" Click="OnForward" />
                        <ui:Button Style="{StaticResource Btn.Icon}" Icon="{ui:SymbolIcon ArrowClockwise20}" ToolTip="重新整理" Click="OnReload" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="ExtraButton" Style="{StaticResource Btn.Secondary}" Visibility="Collapsed"
                                   Icon="{ui:SymbolIcon Star20}" Margin="{StaticResource Gap.Right8}" Click="OnExtra" />
                        <ui:Button Style="{StaticResource Btn.Ghost}" Icon="{ui:SymbolIcon Open20}" Content="用瀏覽器開啟"
                                   ToolTip="用電腦預設的瀏覽器開啟" Margin="{StaticResource Gap.Right8}" Click="OnOpenExternal" />
                        <ui:Button Style="{StaticResource Btn.DialogPrimary}" Icon="{ui:SymbolIcon Checkmark20}" Content="完成" Click="OnClose" />
                    </StackPanel>
                    <TextBlock x:Name="HintText" Style="{StaticResource Text.CaptionSecondary}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="{StaticResource Gap.Right16}" />
                </DockPanel>
            </Border>

            <wv2:WebView2 x:Name="Browser" Grid.Row="2" DefaultBackgroundColor="#0C0F14" />

            <!-- 載入中 -->
            <StackPanel x:Name="LoadingPanel" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32" HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadingText" Text="正在開啟…" Style="{StaticResource Text.BodySecondary}" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="480" HorizontalAlignment="Center" Margin="{StaticResource Gap.Top16}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
