<Window x:Class="RiotAccountHub.Views.WebBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Style="{StaticResource DarkWindowStyle}"
        Width="1180" Height="800" MinWidth="700" MinHeight="500"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- 程式內的簡單瀏覽器（WebView2），用來開 VCRDB 讓使用者自己挑選、複製準星 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Padding="8,5" ToolTip="上一頁" Click="OnBack">
                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Padding="8,5" ToolTip="下一頁" Click="OnForward">
                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Padding="8,5" ToolTip="重新整理" Click="OnReload" Margin="0,0,12,0">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ExtraButton" Visibility="Collapsed" Margin="0,0,8,0" Click="OnExtra">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE734;" Style="{StaticResource ButtonIcon}" Foreground="#FFD978" />
                            <TextBlock x:Name="ExtraButtonText" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" ToolTip="用電腦預設的瀏覽器開啟" Click="OnOpenExternal" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A7;" Style="{StaticResource ButtonIcon}" />
                            <TextBlock Text="用瀏覽器開啟" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Content="完成" MinWidth="80" Click="OnClose" />
                </StackPanel>
                <TextBlock x:Name="HintText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,0,12,0"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="Browser" Grid.Row="1" DefaultBackgroundColor="#0F1115" />

        <TextBlock x:Name="LoadingText" Grid.Row="1" Text="正在開啟…" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource TextMutedBrush}" />
    </Grid>
</Window>
