<Window x:Class="RiotAccountHub.Views.CrosshairEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:RiotAccountHub.Helpers"
        Style="{StaticResource DarkWindowStyle}"
        Title="新增我的準星"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <!-- 新增我的準星：貼上代碼、取名字，下面即時預覽 -->
    <StackPanel Margin="28,22,28,22">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                   Text="在 Valorant「設定 → 準星 → 匯出設定檔代碼」，或從網站複製代碼後貼到下面。" />

        <TextBlock Text="名稱" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
        <TextBox x:Name="NameBox" MaxLength="30" />

        <TextBlock Text="準星代碼" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
        <TextBox x:Name="CodeBox" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" MaxLength="2000"
                 TextChanged="OnCodeChanged" />

        <Border CornerRadius="10" ClipToBounds="True" Height="150" Margin="0,14,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <helpers:CrosshairPreview x:Name="Preview" PixelScale="5" />
        </Border>
        <TextBlock x:Name="StatusText" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" MinWidth="96" Margin="0,0,10,0" IsCancel="True" Click="OnCancel" />
            <Button Content="儲存" MinWidth="96" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
