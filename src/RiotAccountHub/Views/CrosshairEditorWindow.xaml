<ui:FluentWindow x:Class="RiotAccountHub.Views.CrosshairEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:helpers="clr-namespace:RiotAccountHub.Helpers"
                 Style="{StaticResource Window.Dialog}"
                 WindowStartupLocation="CenterOwner"
                 Title="新增我的準星"
                 Width="560"
                 FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <!-- 新增我的準星：貼上代碼、取名字，下面即時預覽 -->
    <Grid>
        <Border Background="{StaticResource Brush.BgTint}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" ShowMinimize="False" ShowMaximize="False" />

            <StackPanel Grid.Row="1" Margin="{StaticResource Pad.Dialog}">
                <DockPanel helpers:Motion.Enter="True">
                    <Border Style="{StaticResource Dialog.IconBox}">
                        <ui:SymbolIcon Symbol="Add24" FontSize="20" Foreground="{StaticResource Brush.TextSecondary}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" />
                        <TextBlock Style="{StaticResource Text.BodySecondary}" Margin="{StaticResource Gap.Top4}" TextWrapping="Wrap"
                                   Text="在 Valorant「設定 → 準星 → 匯出設定檔代碼」，或從網站複製代碼後貼到下面。" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Text="名稱" Style="{StaticResource Field.Label}" Margin="0,24,0,8" />
                <TextBox x:Name="NameBox" Style="{StaticResource Input}" MaxLength="30" />

                <TextBlock Text="準星代碼" Style="{StaticResource Field.Label}" Margin="0,16,0,8" />
                <TextBox x:Name="CodeBox" Style="{StaticResource Input.Code}" MaxLength="2000" TextChanged="OnCodeChanged" />

                <!-- 即時預覽 -->
                <Grid Margin="{StaticResource Gap.Top16}">
                    <Border x:Name="PreviewMask" Background="Black" CornerRadius="{StaticResource Radius.Card}" />
                    <helpers:CrosshairPreview x:Name="Preview" PixelScale="3" Height="{StaticResource Size.EditorPreview}">
                        <helpers:CrosshairPreview.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=PreviewMask}" />
                        </helpers:CrosshairPreview.OpacityMask>
                    </helpers:CrosshairPreview>
                    <Border BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" />
                </Grid>

                <!-- 代碼檢查結果 -->
                <DockPanel Margin="{StaticResource Gap.Top8}">
                    <ui:SymbolIcon x:Name="StatusIcon" Symbol="Info16" FontSize="{StaticResource Size.IconSmall}"
                                   Margin="{StaticResource Gap.Right8}" VerticalAlignment="Top" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Dialog.Footer}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="取消" Style="{StaticResource Btn.DialogSecondary}" IsCancel="True" Click="OnCancel" />
                    <ui:Button Content="儲存" Icon="{ui:SymbolIcon Save20}" Style="{StaticResource Btn.DialogPrimary}" IsDefault="True" Click="OnSave" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
