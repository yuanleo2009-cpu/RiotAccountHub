<Window x:Class="RiotAccountHub.Views.CrosshairDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:RiotAccountHub.Helpers"
        Style="{StaticResource DarkWindowStyle}"
        Title="準星預覽"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <!-- 準星大圖預覽：可以切換背景、複製代碼、收藏、刪除（只有自己的準星能刪） -->
    <StackPanel Margin="28,22,28,22">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="BgDark" Style="{StaticResource ChipRadio}" GroupName="DetailBg" Content="深色" Checked="OnBackgroundChanged" />
                <RadioButton x:Name="BgLight" Style="{StaticResource ChipRadio}" GroupName="DetailBg" Content="淺色" Checked="OnBackgroundChanged" />
                <RadioButton x:Name="BgMap" Style="{StaticResource ChipRadio}" GroupName="DetailBg" Content="地圖灰" Checked="OnBackgroundChanged" Margin="0,0,0,8" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,0,8">
                <TextBlock x:Name="NameText" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SourceText" FontSize="12" Margin="0,3,0,0" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- 大圖（放大 7 倍） -->
        <Border CornerRadius="12" ClipToBounds="True" Height="280" Margin="0,8,0,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <helpers:CrosshairPreview x:Name="Preview" PixelScale="7" />
        </Border>

        <TextBlock Text="準星代碼" Style="{StaticResource FieldLabel}" Margin="0,16,0,6" />
        <TextBox x:Name="CodeBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" />

        <!-- 複製後的提示 -->
        <Border x:Name="CopiedNotice" Visibility="Collapsed" Margin="0,12,0,0" CornerRadius="8" Padding="14,9"
                Background="#263FB950" BorderBrush="#663FB950" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           Foreground="{StaticResource SuccessBrush}" Margin="0,1,10,0" />
                <TextBlock x:Name="CopiedText" TextWrapping="Wrap" FontWeight="SemiBold" />
            </DockPanel>
        </Border>

        <DockPanel Margin="0,18,0,0">
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource DangerGhostButton}" Click="OnDelete">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource ButtonIcon}" />
                    <TextBlock Text="刪除" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="FavoriteButton" Margin="0,0,10,0" Click="OnFavorite" MinWidth="96" />
                <Button Content="關閉" MinWidth="80" Margin="0,0,10,0" IsCancel="True" Click="OnClose" />
                <Button Style="{StaticResource PrimaryButton}" MinWidth="130" Click="OnCopy" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource ButtonIcon}" />
                        <TextBlock Text="複製代碼" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
