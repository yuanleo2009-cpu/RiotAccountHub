<Window x:Class="RiotAccountHub.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DarkWindowStyle}"
        Title="Riot Account Hub"
        Width="460" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=InputBox}">
    <!-- 讓使用者輸入一段文字的小視窗（例如幫設定檔取名字） -->
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" LineHeight="22" />
        <TextBox x:Name="InputBox" Grid.Row="2" Margin="0,16,0,0" MaxLength="30" />
        <TextBlock x:Name="ErrorText" Grid.Row="3" Margin="0,6,0,0" FontSize="12"
                   Foreground="{StaticResource AccentHoverBrush}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" MinWidth="96" Margin="0,0,10,0" IsCancel="True" Click="OnCancel" />
            <Button Content="確定" MinWidth="96" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
