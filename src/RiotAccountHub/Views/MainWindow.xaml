<Window x:Class="RiotAccountHub.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RiotAccountHub.ViewModels"
        xmlns:helpers="clr-namespace:RiotAccountHub.Helpers"
        Style="{StaticResource DarkWindowStyle}"
        Title="Riot Account Hub"
        Icon="pack://application:,,,/RiotAccountHub;component/Assets/app.ico"
        Width="940" Height="680" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <!--
      主畫面。DataContext 是 MainViewModel。
      結構：上方標題列 → 中間帳號卡片 → 下方狀態列，最上層蓋一個「進度畫面」。
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <helpers:ImagePathConverter x:Key="ImagePath" />
    </Window.Resources>

    <Grid>
        <!-- ====================== 主要內容 ====================== -->
        <Grid x:Name="MainContent">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <!-- 忙碌中：鎖住所有按鈕 -->
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 上方標題列 -->
            <DockPanel Margin="28,22,28,14">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Command="{Binding RestoreOriginalCommand}"
                            IsEnabled="{Binding HasOriginalBackup}"
                            ToolTip="把登入狀態還原成第一次使用本程式之前的樣子">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" Style="{StaticResource ButtonIcon}" />
                            <TextBlock Text="還原原本狀態" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddAccountCommand}" Padding="16,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource ButtonIcon}" />
                            <TextBlock Text="新增帳號" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/RiotAccountHub;component/Assets/app.ico" Width="40" Height="40" Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Riot Account Hub" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="帳號切換器 · 點一下就切換並啟動遊戲" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- 帳號卡片列表 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="28,4,22,8">
                <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,0,6,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AccountCardViewModel}">
                            <Border x:Name="CardBorder" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                                <Grid>
                                <!-- 卡片背景：遊戲卡面的長條圖（有下載到才顯示） -->
                                <Border CornerRadius="11" Opacity="0.8"
                                        Visibility="{Binding HasBannerImage, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding BannerImagePath, Converter={StaticResource ImagePath}}"
                                                    Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                    </Border.Background>
                                </Border>
                                <!-- 漸層遮罩：左邊比較暗，讓名字和段位看得清楚 -->
                                <Border CornerRadius="11"
                                        Visibility="{Binding HasBannerImage, Converter={StaticResource BoolToVisibility}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F2171A21" Offset="0" />
                                            <GradientStop Color="#A8171A21" Offset="0.45" />
                                            <GradientStop Color="#78171A21" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <Grid Margin="20,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 頭像：有卡面就顯示卡面，沒有就顯示名稱第一個字 -->
                                    <Grid Width="56" Height="56" Margin="0,0,18,0" VerticalAlignment="Center">
                                        <Border CornerRadius="12">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3A2024" Offset="0" />
                                                    <GradientStop Color="#24161A" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentHoverBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="12" BorderThickness="1" BorderBrush="#40FFFFFF"
                                                Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding AvatarImagePath, Converter={StaticResource ImagePath}}"
                                                            Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <!-- 帳號資訊 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <!-- Riot ID：名字大字，#Tag 小一點 -->
                                        <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding RiotId}">
                                            <Run Text="{Binding GameName, Mode=OneWay}" FontSize="24" FontWeight="Bold" />
                                            <Run Text="{Binding TagText, Mode=OneWay}" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </TextBlock>

                                        <!-- 標籤：登入方式、備註、警告 -->
                                        <WrapPanel Margin="0,8,0,0">
                                            <!-- 段位（自己設計的顏色標籤，不使用官方圖示） -->
                                            <Border Style="{StaticResource Tag}" ToolTip="{Binding RankToolTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding RankColor}" VerticalAlignment="Center" Margin="0,1,7,0" />
                                                    <TextBlock Text="{Binding RankText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding RankColor}" />
                                                    <TextBlock Text="{Binding LeaderboardText}" FontSize="12" Margin="6,0,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Visibility="{Binding HasLeaderboard, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tag}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,1,6,0" />
                                                    <TextBlock Text="{Binding LoginMethodText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Tag}" Background="{StaticResource AccentSoftBrush}"
                                                    Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource TextBrush}" />
                                            </Border>
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource Tag}">
                                                        <Setter Property="Background" Value="#33E3B341" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSnapshot}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="沒有登入狀態，請按「重新登入」" FontSize="12" Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                        </WrapPanel>

                                        <TextBlock Text="{Binding LastUsedText}" FontSize="12" Margin="0,8,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>

                                    <!-- 動作按鈕 -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button Style="{StaticResource PrimaryButton}" Height="44" MinWidth="200" FontSize="15"
                                                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" Style="{StaticResource ButtonIcon}" />
                                                <TextBlock Text="啟動" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}" FontSize="13" Padding="8,5"
                                                    ToolTip="登入狀態過期時，重新登入並更新"
                                                    Command="{Binding DataContext.ReloginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE72C;" Style="{StaticResource ButtonIcon}" FontSize="12" Margin="0,1,5,0" />
                                                    <TextBlock Text="重新登入" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" FontSize="13" Padding="8,5"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE70F;" Style="{StaticResource ButtonIcon}" FontSize="12" Margin="0,1,5,0" />
                                                    <TextBlock Text="編輯" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource DangerGhostButton}" FontSize="13" Padding="8,5"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource ButtonIcon}" FontSize="12" Margin="0,1,5,0" />
                                                    <TextBlock Text="刪除" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <!-- 滑鼠移到卡片上，外框變亮 -->
                                <Trigger SourceName="CardBorder" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 沒有帳號時的引導畫面 -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource SurfaceBrush}" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="30"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="還沒有任何帳號" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock Text="按「新增帳號」，在 Riot Client 登入一次，之後就能一鍵切換。" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddAccountCommand}"
                        HorizontalAlignment="Center" Margin="0,22,0,0" Padding="20,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource ButtonIcon}" />
                        <TextBlock Text="新增第一個帳號" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 下方狀態列 -->
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" FontSize="12"
                            Command="{Binding OpenDataFolderCommand}" ToolTip="打開 %AppData%\RiotAccountHub">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" Style="{StaticResource ButtonIcon}" FontSize="12" Margin="0,1,6,0" />
                            <TextBlock Text="資料夾" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Riot Client：" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RiotClientPathText}" FontSize="12" MaxWidth="480"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding RiotClientPathText}" />
                        <Button Style="{StaticResource GhostButton}" FontSize="12" Margin="6,0,0,0" Padding="8,4"
                                Content="變更" Command="{Binding ChangeRiotClientPathCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ====================== 進度畫面（忙碌時蓋在最上層） ====================== -->
        <Grid Background="{StaticResource OverlayBrush}"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="32,28">
                <StackPanel>
                    <!-- 轉圈圈（完成時換成綠色勾勾） -->
                    <Grid Width="44" Height="44" HorizontalAlignment="Center">
                        <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 22,4 A 18,18 0 1 1 4,22" RenderTransformOrigin="0.5,0.5">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BusyCompleted}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.9" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                        <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="40"
                                   Foreground="{StaticResource SuccessBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding BusyCompleted, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <TextBlock Text="{Binding BusyTitle}" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,18,0,0" TextTrimming="CharacterEllipsis" />

                    <!-- 步驟：關閉中 → 切換中 → 啟動中 -->
                    <ItemsControl ItemsSource="{Binding BusySteps}" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BusyStepItem}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0" />
                                    <Border x:Name="Chip" CornerRadius="12" Padding="12,4" BorderThickness="1"
                                            Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Margin="0,1,5,0" VerticalAlignment="Center" Visibility="Collapsed"
                                                       Foreground="{StaticResource SuccessBrush}" />
                                            <TextBlock x:Name="Label" Text="{Binding Text}" FontSize="13"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:StepState.Active}">
                                        <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:StepState.Done}">
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                    <!-- 第一個步驟前面不要箭頭 -->
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                        <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding BusyDetail}" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
