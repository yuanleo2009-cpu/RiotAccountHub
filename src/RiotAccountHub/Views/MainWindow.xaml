<ui:FluentWindow x:Class="RiotAccountHub.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                 xmlns:vm="clr-namespace:RiotAccountHub.ViewModels"
                 xmlns:helpers="clr-namespace:RiotAccountHub.Helpers"
                 Style="{StaticResource Window.App}"
                 Title="Riot Account Hub"
                 Icon="pack://application:,,,/RiotAccountHub;component/Assets/app.ico"
                 Width="1000" Height="720" MinWidth="880" MinHeight="540"
                 WindowStartupLocation="CenterScreen">
    <!--
      主畫面。DataContext 是 MainViewModel。
      結構：標題列 → 頁面標題與按鈕 →（已複製橫幅）→ 帳號卡片 → 底部狀態列，
            最上層蓋一個有動畫的「進度畫面」。
      顏色、字號、間距都來自 Themes/Tokens.xaml，這裡不直接寫數值。
    -->
    <ui:FluentWindow.Resources>
        <helpers:ImagePathConverter x:Key="ImagePath" />

        <!-- 進度步驟的尺寸：每一步寬 80，圓點 24，中間的連接線 56（= 80 − 24） -->
        <sys:Double x:Key="Stepper.ItemWidth">80</sys:Double>
        <sys:Double x:Key="Stepper.Dot">24</sys:Double>
        <sys:Double x:Key="Stepper.LineWidth">56</sys:Double>
        <Thickness x:Key="Stepper.LineOffset">-28,0,0,0</Thickness>
    </ui:FluentWindow.Resources>

    <Grid>
        <!-- 背景：Mica 上面蓋一層冷黑色罩，右上角一點紅色光暈 -->
        <Border Background="{StaticResource Brush.BgTint}" />
        <Border Background="{StaticResource Brush.AccentGlow}" IsHitTestVisible="False" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ====================== 標題列（可拖曳，右邊是最小化 / 最大化 / 關閉） ====================== -->
            <ui:TitleBar Grid.Row="0" Title="Riot Account Hub">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/RiotAccountHub;component/Assets/logo.png" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <!-- ====================== 頁面內容 ====================== -->
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <!-- 忙碌中：鎖住所有按鈕 -->
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 頁面標題與主要按鈕 -->
                <DockPanel Grid.Row="0" Margin="{StaticResource Pad.Page}" helpers:Motion.Enter="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Style="{StaticResource Btn.Ghost}" Margin="{StaticResource Gap.Right8}"
                                   Icon="{ui:SymbolIcon ArrowUndo20}" Content="還原原本狀態"
                                   Command="{Binding RestoreOriginalCommand}"
                                   IsEnabled="{Binding HasOriginalBackup}"
                                   ToolTip="把登入狀態還原成第一次使用本程式之前的樣子" />
                        <ui:Button Style="{StaticResource Btn.Secondary}" Margin="{StaticResource Gap.Right8}"
                                   Icon="{ui:SymbolIcon Target20}" Content="熱門準星"
                                   Command="{Binding OpenCrosshairsCommand}"
                                   ToolTip="在程式裡打開 VCRDB，直接挑熱門準星、複製代碼" />
                        <ui:Button Style="{StaticResource Btn.Primary}"
                                   Icon="{ui:SymbolIcon Add20}" Content="新增帳號"
                                   Command="{Binding AddAccountCommand}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="我的帳號" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="{Binding AccountSummary}" Style="{StaticResource Text.Caption}"
                                   Margin="{StaticResource Gap.Top4}" />
                    </StackPanel>
                </DockPanel>

                <!-- 「已複製」橫幅（有複製設定時才顯示） -->
                <Grid Grid.Row="1" helpers:Motion.IsShown="{Binding HasCopiedSettings}" helpers:Motion.ShowMode="Expand">
                <Border Style="{StaticResource Panel}" Margin="{StaticResource Gap.Banner}"
                        Padding="{StaticResource Pad.Notice}" CornerRadius="{StaticResource Radius.Control}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Style="{StaticResource Btn.GhostSmall}"
                                   Icon="{ui:SymbolIcon Dismiss16}" Content="清除"
                                   Command="{Binding ClearCopiedSettingsCommand}" ToolTip="不再顯示「套用設定」按鈕" />
                        <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Copy20" FontSize="{StaticResource Size.Icon}"
                                       Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"
                                       Margin="{StaticResource Gap.Right8}" />
                        <TextBlock Text="{Binding CopiedSettingsText}" Style="{StaticResource Text.BodySecondary}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
                </Grid>

                <!-- 帳號卡片列表 -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="{StaticResource Pad.List}">
                    <ItemsControl ItemsSource="{Binding Accounts}" Margin="{StaticResource Gap.Right8}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccountCardViewModel}">
                                <!-- Card.Interactive：滑過會浮起、邊框和左側的線變紅 -->
                                <ContentControl Style="{StaticResource Card.Interactive}" Margin="{StaticResource Gap.Bottom16}"
                                                helpers:Motion.Enter="True"
                                                helpers:CardState.IsActive="{Binding HasActivity}">
                                    <Grid>
                                        <!-- 卡片背景：遊戲卡面的長條圖（有下載到才顯示），上面蓋一層漸層讓文字清楚 -->
                                        <Border Opacity="0.7"
                                                Visibility="{Binding HasBannerImage, Converter={StaticResource BoolToVis}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding BannerImagePath, Converter={StaticResource ImagePath}}"
                                                            Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center" />
                                            </Border.Background>
                                        </Border>
                                        <Border Background="{StaticResource Brush.CardBannerFade}"
                                                Visibility="{Binding HasBannerImage, Converter={StaticResource BoolToVis}}" />

                                        <Grid Margin="{StaticResource Pad.Card}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 頭像：有卡面就顯示卡面，沒有就顯示名稱第一個字 -->
                                            <Grid Width="{StaticResource Size.Avatar}" Height="{StaticResource Size.Avatar}"
                                                  Margin="{StaticResource Gap.Right16}" VerticalAlignment="Center">
                                                <Border CornerRadius="{StaticResource Radius.Control}"
                                                        Background="{StaticResource Brush.AvatarFallback}">
                                                    <TextBlock Text="{Binding Initial}" Style="{StaticResource Text.Title}"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border CornerRadius="{StaticResource Radius.Control}"
                                                        BorderBrush="{StaticResource Brush.StrokeStrong}" BorderThickness="1"
                                                        Visibility="{Binding HasAvatarImage, Converter={StaticResource BoolToVis}}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{Binding AvatarImagePath, Converter={StaticResource ImagePath}}"
                                                                    Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>

                                            <!-- 帳號資訊 -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <!-- Riot ID：整張卡片最醒目的字 -->
                                                <TextBlock Style="{StaticResource Text.Display}" ToolTip="{Binding RiotId}">
                                                    <Run Text="{Binding GameName, Mode=OneWay}" />
                                                    <Run Text="{Binding TagText, Mode=OneWay}" FontSize="{StaticResource Font.Subtitle}"
                                                         FontWeight="Normal" Foreground="{StaticResource Brush.TextMuted}" />
                                                </TextBlock>

                                                <!-- 標籤 -->
                                                <WrapPanel Margin="{StaticResource Gap.Top8}">
                                                    <!-- 目前狀態：啟動中 / 遊戲中 / 已登入（這是重點資訊，所以用紅色） -->
                                                    <Border Style="{StaticResource Chip.Accent}"
                                                            helpers:Motion.IsShown="{Binding HasActivity}"
                                                            ToolTip="{Binding ActivityToolTip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Fill="{StaticResource Brush.Accent}" VerticalAlignment="Center"
                                                                     Margin="{StaticResource Gap.Right8}">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Style.Triggers>
                                                                            <!-- 啟動中：小圓點一閃一閃 -->
                                                                            <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                                                                <DataTrigger.EnterActions>
                                                                                    <BeginStoryboard x:Name="LaunchingPulse">
                                                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                             From="1" To="0.25" Duration="0:0:0.6" />
                                                                                        </Storyboard>
                                                                                    </BeginStoryboard>
                                                                                </DataTrigger.EnterActions>
                                                                                <DataTrigger.ExitActions>
                                                                                    <StopStoryboard BeginStoryboardName="LaunchingPulse" />
                                                                                </DataTrigger.ExitActions>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                            <TextBlock Text="{Binding ActivityText}" Style="{StaticResource Chip.Text}" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Brush.Accent}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 主帳號 -->
                                                    <Border Style="{StaticResource Chip}"
                                                            helpers:Motion.IsShown="{Binding IsMain}"
                                                            ToolTip="主帳號：它的遊戲設定可以一鍵套用到其他帳號">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Star16" Filled="True" FontSize="{StaticResource Size.IconSmall}"
                                                                           Foreground="{StaticResource Brush.Accent}" Margin="{StaticResource Gap.Right4}" />
                                                            <TextBlock Text="主帳號" Style="{StaticResource Chip.Text}" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Brush.Text}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 段位：顏色小圓點 + 名稱（不使用官方圖示） -->
                                                    <Border Style="{StaticResource Chip}" ToolTip="{Binding RankToolTip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding RankColor}" VerticalAlignment="Center"
                                                                     Margin="{StaticResource Gap.Right8}" />
                                                            <TextBlock Text="{Binding RankText}" Style="{StaticResource Chip.Text}" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Brush.Text}" />
                                                            <TextBlock Text="{Binding LeaderboardText}" Style="{StaticResource Chip.Text}"
                                                                       Margin="{StaticResource Gap.Left8}"
                                                                       Visibility="{Binding HasLeaderboard, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 登入方式：小圖示 + 文字 -->
                                                    <Border Style="{StaticResource Chip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="{Binding LoginMethodIcon}" FontSize="{StaticResource Size.IconSmall}"
                                                                           Foreground="{StaticResource Brush.TextMuted}" Margin="{StaticResource Gap.Right4}" />
                                                            <TextBlock Text="{Binding LoginMethodText}" Style="{StaticResource Chip.Text}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 備註 -->
                                                    <Border Style="{StaticResource Chip}"
                                                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Chip.Text}" />
                                                    </Border>
                                                    <!-- 已套用的遊戲設定 -->
                                                    <Border Style="{StaticResource Chip}" ToolTip="{Binding AppliedSettingsToolTip}"
                                                            helpers:Motion.IsShown="{Binding HasAppliedSettings}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Keyboard16" FontSize="{StaticResource Size.IconSmall}"
                                                                           Foreground="{StaticResource Brush.TextMuted}" Margin="{StaticResource Gap.Right4}" />
                                                            <TextBlock Text="{Binding AppliedSettingsText}" Style="{StaticResource Chip.Text}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- 警告：沒有登入狀態 -->
                                                    <Border>
                                                        <Border.Style>
                                                            <Style TargetType="Border" BasedOn="{StaticResource Chip.Warning}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasSnapshot}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <ui:SymbolIcon Symbol="Warning16" FontSize="{StaticResource Size.IconSmall}"
                                                                           Foreground="{StaticResource Brush.Warning}" Margin="{StaticResource Gap.Right4}" />
                                                            <TextBlock Text="沒有登入狀態，請按「重新登入」" Style="{StaticResource Chip.Text}"
                                                                       Foreground="{StaticResource Brush.Warning}" />
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>

                                                <TextBlock Text="{Binding LastUsedText}" Style="{StaticResource Text.Caption}"
                                                           Margin="{StaticResource Gap.Top4}" />
                                            </StackPanel>

                                            <!-- 動作按鈕 -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="{StaticResource Gap.Left16}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <!-- 套用主帳號設定（有主帳號、而且這張不是主帳號時才顯示） -->
                                                    <ui:Button Style="{StaticResource Btn.SecondaryLarge}" Margin="{StaticResource Gap.Right8}"
                                                               Icon="{ui:SymbolIcon Star20}" Content="套用主帳號"
                                                               helpers:Motion.IsShown="{Binding CanApplyMain}"
                                                               ToolTip="切換到這個帳號、套用主帳號的鍵位 / 靈敏度 / 準星，然後開始遊戲"
                                                               Command="{Binding DataContext.ApplyMainSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}" />
                                                    <!-- 套用複製的設定（有複製、而且這張不是來源時才顯示） -->
                                                    <ui:Button Style="{StaticResource Btn.SecondaryLarge}" Margin="{StaticResource Gap.Right8}"
                                                               Icon="{ui:SymbolIcon ClipboardPaste20}" Content="套用設定"
                                                               helpers:Motion.IsShown="{Binding CanApplyCopied}"
                                                               ToolTip="切換到這個帳號、套用剛剛複製的鍵位 / 靈敏度 / 準星，然後開始遊戲"
                                                               Command="{Binding DataContext.ApplyCopiedSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}" />
                                                    <!-- 啟動：卡片上最顯眼的按鈕 -->
                                                    <!-- 按鈕會跟著狀態變：「▶ 啟動」→（轉圈）「啟動中」→「遊戲中」 -->
                                                    <ui:Button ToolTip="{Binding LaunchButtonToolTip}"
                                                               Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}">
                                                        <ui:Button.Style>
                                                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource Btn.Launch}">
                                                                <Style.Triggers>
                                                                    <!-- 啟動中 / 遊戲中：從實心紅換成「紅框 + 淡紅底」，表示這是狀態、不是待按的動作 -->
                                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}" />
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentStroke}" />
                                                                        <Setter Property="MouseOverBackground" Value="{StaticResource Brush.AccentSoft}" />
                                                                        <Setter Property="PressedBackground" Value="{StaticResource Brush.AccentSoft}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Grid Margin="{StaticResource Gap.Right8}" VerticalAlignment="Center">
                                                                <ui:SymbolIcon Symbol="Play20" Filled="True" FontSize="{StaticResource Size.Icon}"
                                                                               Foreground="{StaticResource Brush.TextOnAccent}"
                                                                               Visibility="{Binding IsNotRunning, Converter={StaticResource BoolToVis}}" />
                                                                <Control Style="{StaticResource Spinner}" Foreground="{StaticResource Brush.TextOnAccent}"
                                                                         Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVis}}" />
                                                                <ui:SymbolIcon Symbol="Games20" Filled="True" FontSize="{StaticResource Size.Icon}"
                                                                               Foreground="{StaticResource Brush.TextOnAccent}"
                                                                               Visibility="{Binding IsInGame, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding LaunchButtonText}" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Brush.TextOnAccent}" />
                                                        </StackPanel>
                                                    </ui:Button>
                                                </StackPanel>

                                                <!-- 次要動作：兩個常用的有文字，其他只放圖示（滑鼠移上去有說明） -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Gap.Top8}">
                                                    <!-- 戰績：用內建瀏覽器打開 Tracker.gg 的個人頁面 -->
                                                    <ui:Button Style="{StaticResource Btn.GhostSmall}"
                                                               Icon="{ui:SymbolIcon DataTrending20}" Content="戰績"
                                                               ToolTip="在 Tracker.gg 看這個帳號的戰績（用程式內的瀏覽器開啟）"
                                                               Command="{Binding DataContext.OpenTrackerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Icon="{ui:SymbolIcon Copy20}" Content="{Binding CopyButtonText}"
                                                               ToolTip="複製這個帳號的鍵位、靈敏度、準星，再到其他帳號按「套用設定」"
                                                               Command="{Binding DataContext.CopySettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}">
                                                        <ui:Button.Style>
                                                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource Btn.GhostSmall}">
                                                                <Style.Triggers>
                                                                    <!-- 目前複製的就是這個帳號：用強調色表示「選中」 -->
                                                                    <DataTrigger Binding="{Binding IsCopySource}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource Btn.GhostSmall}"
                                                               Icon="{ui:SymbolIcon ArrowUndo20}" Content="還原設定"
                                                               helpers:Motion.IsShown="{Binding HasSettingsBackup}"
                                                               ToolTip="把這個帳號的遊戲設定改回最近一次套用前的樣子"
                                                               Command="{Binding DataContext.RestoreSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button ToolTip="{Binding MainToggleToolTip}"
                                                               Command="{Binding DataContext.ToggleMainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}">
                                                        <ui:Button.Style>
                                                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource Btn.Icon}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMain}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:Button.Style>
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="Star20" Filled="{Binding IsMain}" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Icon="{ui:SymbolIcon ArrowSync20}"
                                                               ToolTip="重新登入：登入狀態過期時，重新登入並更新"
                                                               Command="{Binding DataContext.ReloginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Style="{StaticResource Btn.Icon}" Icon="{ui:SymbolIcon Edit20}"
                                                               ToolTip="編輯名稱、登入方式、備註"
                                                               Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}" />
                                                    <ui:Button Style="{StaticResource Btn.IconDanger}" Icon="{ui:SymbolIcon Delete20}"
                                                               ToolTip="刪除這個帳號"
                                                               Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 空狀態：還沒有任何帳號時的引導畫面 -->
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640"
                            helpers:Motion.IsShown="{Binding IsEmpty}" helpers:Motion.Enter="True">
                    <!-- 插圖：三張疊在一起的空白帳號卡片（自己畫的，沒有使用任何官方圖片） -->
                    <Grid Width="280" Height="112" HorizontalAlignment="Center">
                        <Border Style="{StaticResource Panel}" CornerRadius="{StaticResource Radius.Card}"
                                Width="232" Height="64" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="-6" />
                                    <TranslateTransform X="-16" Y="-16" />
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                        <Border Style="{StaticResource Panel}" CornerRadius="{StaticResource Radius.Card}"
                                Width="232" Height="64" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <RotateTransform Angle="4" />
                                    <TranslateTransform X="16" Y="-8" />
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                        <Border Style="{StaticResource Panel}" CornerRadius="{StaticResource Radius.Card}"
                                Width="248" Height="72" VerticalAlignment="Bottom">
                            <Grid>
                                <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource Brush.Accent}"
                                        CornerRadius="3,0,0,3" Margin="0,8" />
                                <StackPanel Orientation="Horizontal" Margin="16,0">
                                    <Border Width="40" Height="40" CornerRadius="{StaticResource Radius.Control}"
                                            Background="{StaticResource Brush.AvatarFallback}">
                                        <ui:SymbolIcon Symbol="Person20" FontSize="20" Foreground="{StaticResource Brush.TextSecondary}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="{StaticResource Gap.Left16}">
                                        <Border Width="88" Height="8" CornerRadius="{StaticResource Radius.Control}"
                                                Background="{StaticResource Brush.StrokeStrong}" HorizontalAlignment="Left" />
                                        <Border Width="56" Height="8" CornerRadius="{StaticResource Radius.Control}"
                                                Background="{StaticResource Brush.Surface3}" HorizontalAlignment="Left"
                                                Margin="{StaticResource Gap.Top8}" />
                                    </StackPanel>
                                    <Border Width="48" Height="24" CornerRadius="{StaticResource Radius.Control}"
                                            Background="{StaticResource Brush.Accent}" VerticalAlignment="Center"
                                            Margin="{StaticResource Gap.Left16}">
                                        <ui:SymbolIcon Symbol="Play20" Filled="True" FontSize="{StaticResource Size.IconSmall}"
                                                       Foreground="{StaticResource Brush.TextOnAccent}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock Text="還沒有任何帳號" Style="{StaticResource Text.Title}" HorizontalAlignment="Center"
                               Margin="{StaticResource Gap.Top32}" />
                    <TextBlock Text="把每個帳號登入一次存起來，之後點一下就能切換到那個帳號並開始遊戲。"
                               Style="{StaticResource Text.BodySecondary}" TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="{StaticResource Gap.Top8}" />

                    <!-- 三個步驟 -->
                    <UniformGrid Columns="3" Margin="{StaticResource Gap.Top32}">
                        <StackPanel Margin="{StaticResource Gap.Right16}">
                            <Border Width="{StaticResource Stepper.Dot}" Height="{StaticResource Stepper.Dot}" CornerRadius="12"
                                    Background="{StaticResource Brush.AccentSoft}" HorizontalAlignment="Center">
                                <TextBlock Text="1" Style="{StaticResource Text.Caption}" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="按下面的「新增第一個帳號」" Style="{StaticResource Text.CaptionSecondary}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="{StaticResource Gap.Top8}" />
                        </StackPanel>
                        <StackPanel Margin="{StaticResource Gap.Right16}">
                            <Border Width="{StaticResource Stepper.Dot}" Height="{StaticResource Stepper.Dot}" CornerRadius="12"
                                    Background="{StaticResource Brush.AccentSoft}" HorizontalAlignment="Center">
                                <TextBlock Text="2" Style="{StaticResource Text.Caption}" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="在 Riot Client 登入，記得勾選「保持登入」" Style="{StaticResource Text.CaptionSecondary}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="{StaticResource Gap.Top8}" />
                        </StackPanel>
                        <StackPanel>
                            <Border Width="{StaticResource Stepper.Dot}" Height="{StaticResource Stepper.Dot}" CornerRadius="12"
                                    Background="{StaticResource Brush.AccentSoft}" HorizontalAlignment="Center">
                                <TextBlock Text="3" Style="{StaticResource Text.Caption}" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="之後在帳號卡片上按「啟動」就能一鍵切換" Style="{StaticResource Text.CaptionSecondary}"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="{StaticResource Gap.Top8}" />
                        </StackPanel>
                    </UniformGrid>

                    <ui:Button Style="{StaticResource Btn.Launch}" HorizontalAlignment="Center" Margin="{StaticResource Gap.Top32}"
                               Icon="{ui:SymbolIcon Add20}" Content="新增第一個帳號"
                               Command="{Binding AddAccountCommand}" />
                </StackPanel>

                <!-- 底部狀態列 -->
                <Border Grid.Row="3" BorderBrush="{StaticResource Brush.Stroke}" BorderThickness="0,1,0,0"
                        Padding="{StaticResource Pad.Bar}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="開機時自動開啟" Style="{StaticResource Text.CaptionSecondary}" VerticalAlignment="Center"
                                       Margin="{StaticResource Gap.Right8}"
                                       ToolTip="登入 Windows 時自動開啟本程式（會縮小在工作列，不會跳出視窗）。" />
                            <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center"
                                             Margin="{StaticResource Gap.Right16}"
                                             ToolTip="登入 Windows 時自動開啟本程式（會縮小在工作列，不會跳出視窗）。" />
                            <TextBlock Text="關閉 Riot 影片和聲音" Style="{StaticResource Text.CaptionSecondary}" VerticalAlignment="Center"
                                       Margin="{StaticResource Gap.Right8}"
                                       ToolTip="切換帳號時，自動關掉 Riot Client 主畫面的背景影片和影片聲音（右下角的喇叭、攝影機按鈕）。" />
                            <ui:ToggleSwitch IsChecked="{Binding MuteRiotClientMedia}" VerticalAlignment="Center"
                                             Margin="{StaticResource Gap.Right16}"
                                             ToolTip="切換帳號時，自動關掉 Riot Client 主畫面的背景影片和影片聲音（右下角的喇叭、攝影機按鈕）。" />
                            <TextBlock Text="按啟動後自動開始遊戲" Style="{StaticResource Text.CaptionSecondary}" VerticalAlignment="Center"
                                       Margin="{StaticResource Gap.Right8}"
                                       ToolTip="開啟後，按「啟動」不用再到 Riot Client 按「開始遊戲」，登入完成就會自動開始。" />
                            <ui:ToggleSwitch IsChecked="{Binding AutoStartGame}" VerticalAlignment="Center"
                                             ToolTip="開啟後，按「啟動」不用再到 Riot Client 按「開始遊戲」，登入完成就會自動開始。" />
                            <ui:Button Style="{StaticResource Btn.Icon}" Icon="{ui:SymbolIcon Folder20}" Margin="{StaticResource Gap.Left16}"
                                       Command="{Binding OpenDataFolderCommand}" ToolTip="打開程式資料夾（%AppData%\RiotAccountHub）" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Riot Client" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RiotClientPathText}" Style="{StaticResource Text.CaptionSecondary}"
                                       MaxWidth="240" VerticalAlignment="Center" Margin="{StaticResource Gap.Left8}"
                                       ToolTip="{Binding RiotClientPathText}" />
                            <ui:Button Style="{StaticResource Btn.GhostSmall}" Content="變更" Margin="{StaticResource Gap.Left8}"
                                       Command="{Binding ChangeRiotClientPathCommand}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ====================== 進度畫面（忙碌時淡入，蓋在頁面上；標題列還是可以拖曳） ====================== -->
            <Grid Grid.Row="1" Background="{StaticResource Brush.Overlay}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="Opacity" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <!-- 出現：淡入 200 毫秒 -->
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1"
                                                             Duration="{StaticResource Motion.Normal}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <!-- 消失：淡出 150 毫秒後收起來 -->
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0"
                                                             Duration="{StaticResource Motion.Fast}" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0.15" Value="{x:Static Visibility.Collapsed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Padding="{StaticResource Pad.Panel}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Panel}">
                            <Style.Triggers>
                                <!-- 面板出現時從 96% 放大到 100% -->
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 From="0.96" To="1" Duration="{StaticResource Motion.Slow}">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 From="0.96" To="1" Duration="{StaticResource Motion.Slow}">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <!-- 進行中：轉圈；完成：打勾（彈出來） -->
                        <Grid Width="48" Height="48" HorizontalAlignment="Center">
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BusyCompleted}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"
                                                 Foreground="{StaticResource Brush.Accent}" />
                            </Grid>
                            <Border CornerRadius="24" Background="{StaticResource Brush.SuccessSoft}" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BusyCompleted}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             From="0.5" To="1" Duration="{StaticResource Motion.Slow}">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.8" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             From="0.5" To="1" Duration="{StaticResource Motion.Slow}">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.8" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <ui:SymbolIcon Symbol="Checkmark20" FontSize="24" Foreground="{StaticResource Brush.Success}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding BusyTitle}" Style="{StaticResource Text.Subtitle}"
                                   HorizontalAlignment="Center" Margin="{StaticResource Gap.Top16}" />

                        <!-- 步驟：關閉中 ── 切換中 ── 啟動中（輪到的步驟會亮起來，連接線會填滿） -->
                        <ItemsControl ItemsSource="{Binding BusySteps}" HorizontalAlignment="Center" Margin="{StaticResource Gap.Top24}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BusyStepItem}">
                                    <StackPanel Width="{StaticResource Stepper.ItemWidth}">
                                        <Grid Height="{StaticResource Stepper.Dot}">
                                            <!-- 連到上一步的線（第一步沒有） -->
                                            <Grid x:Name="Connector" Width="{StaticResource Stepper.LineWidth}" Height="2"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                  Margin="{StaticResource Stepper.LineOffset}">
                                                <Rectangle Fill="{StaticResource Brush.StrokeStrong}" />
                                                <Rectangle x:Name="ConnectorFill" Fill="{StaticResource Brush.Accent}" RenderTransformOrigin="0,0.5">
                                                    <Rectangle.RenderTransform>
                                                        <ScaleTransform ScaleX="0" ScaleY="1" />
                                                    </Rectangle.RenderTransform>
                                                </Rectangle>
                                            </Grid>
                                            <!-- 圓點 -->
                                            <Grid Width="{StaticResource Stepper.Dot}" Height="{StaticResource Stepper.Dot}" HorizontalAlignment="Center">
                                                <Ellipse x:Name="Ring" Stroke="{StaticResource Brush.StrokeStrong}" StrokeThickness="2"
                                                         Fill="{StaticResource Brush.Surface1}" />
                                                <Ellipse x:Name="ActiveDot" Width="8" Height="8" Opacity="0" Fill="{StaticResource Brush.Accent}" />
                                                <Ellipse x:Name="DoneFill" Opacity="0" Fill="{StaticResource Brush.Accent}" />
                                                <ui:SymbolIcon x:Name="DoneCheck" Symbol="Checkmark16" FontSize="{StaticResource Size.IconSmall}" Opacity="0"
                                                               Foreground="{StaticResource Brush.TextOnAccent}" />
                                            </Grid>
                                        </Grid>
                                        <TextBlock x:Name="Label" Text="{Binding Text}" Style="{StaticResource Text.Caption}"
                                                   HorizontalAlignment="Center" Margin="{StaticResource Gap.Top8}" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <!-- 第一個步驟前面沒有連接線 -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                            <Setter TargetName="Connector" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <!-- 輪到這一步：連接線從左到右填滿，圓圈和文字亮起來 -->
                                        <DataTrigger Binding="{Binding IsReached}" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.Accent}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Text}" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ConnectorFill"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1" Duration="{StaticResource Motion.Slow}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                        <!-- 進行中：中間的小紅點一閃一閃 -->
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="Pulse">
                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                        <DoubleAnimation Storyboard.TargetName="ActiveDot" Storyboard.TargetProperty="Opacity"
                                                                         From="1" To="0.25" Duration="0:0:0.6" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="Pulse" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <!-- 完成：圓圈填滿紅色並打勾 -->
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="DoneFill" Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="{StaticResource Motion.Normal}" />
                                                        <DoubleAnimation Storyboard.TargetName="DoneCheck" Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="{StaticResource Motion.Normal}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding BusyDetail}" Style="{StaticResource Text.BodySecondary}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="{StaticResource Gap.Top24}" />

                        <!-- 「遊戲設定已套用」之類的成功提示（有內容才顯示） -->
                        <Border Margin="{StaticResource Gap.Top16}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Notice.Success}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding BusyNotice}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="CheckmarkCircle20" FontSize="{StaticResource Size.Icon}"
                                               Foreground="{StaticResource Brush.Success}" VerticalAlignment="Top"
                                               Margin="{StaticResource Gap.Right8}" />
                                <TextBlock Text="{Binding BusyNotice}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
