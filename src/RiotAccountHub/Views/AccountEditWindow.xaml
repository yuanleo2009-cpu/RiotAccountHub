<Window x:Class="RiotAccountHub.Views.AccountEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RiotAccountHub.ViewModels"
        Style="{StaticResource DarkWindowStyle}"
        Title="{Binding WindowTitle}"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <!-- 填寫 / 編輯帳號資料。DataContext 是 AccountEditViewModel -->
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Headline}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Riot ID：名稱 # Tag -->
        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="遊戲名稱" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="NameBox" Text="{Binding GameName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="#" FontSize="20" Margin="10,0,10,8" VerticalAlignment="Bottom"
                       Foreground="{StaticResource TextMutedBrush}" />
            <StackPanel Grid.Column="2">
                <TextBlock Text="Tag" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding TagLine, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" />
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                   Text="小技巧：直接在「遊戲名稱」貼上「名字#Tag」會自動拆開。" />

        <!-- 登入方式 -->
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="登入方式" Style="{StaticResource FieldLabel}" />
            <ItemsControl ItemsSource="{Binding Methods}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LoginMethodOption}">
                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="LoginMethod"
                                     Content="{Binding Display}"
                                     IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- 備註 -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="備註（選填，例如「主號」、「小號」）" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
        </StackPanel>

        <!-- 錯誤訊息 + 按鈕 -->
        <DockPanel Grid.Row="5" Margin="0,24,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="取消" MinWidth="96" Margin="0,0,10,0" IsCancel="True" Click="OnCancel" />
                <Button Content="儲存" MinWidth="96" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnSave" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentHoverBrush}"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
